# Copy to .env and fill in. Never commit .env.

# Postgres (local container)
POSTGRES_USER=context
POSTGRES_PASSWORD=change-me
POSTGRES_DB=context
DATABASE_URL=postgresql://context:change-me@postgres:5432/context

# LLM (Meta Llama hackathon credits; OpenAI-compatible endpoint)
LLM_PROVIDER=llama
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_LARGE=
LLM_MODEL_SMALL=

# Embeddings (local model container by default)
EMBEDDING_PROVIDER=local
EMBEDDING_BASE_URL=http://embeddings:11434
EMBEDDING_MODEL=nomic-embed-text

# Adapters (local defaults)
EVENT_BUS=postgres_outbox
OBJECT_STORE=local
OBJECT_STORE_PATH=./local-data/objects
SECRET_STORE=env

# Cloud (only when deploying; keep real values in .env or a secret store)
GCP_PROJECT_ID=
